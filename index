function chooseFish(luckyBoost=save.luckyBait>0){
 const list=species.filter(f=>f.zones.includes(save.zone)).map(f=>({f,w:f.weight}));
 const boost=(save.bait-1)*.20+(save.sonar-1)*.28+(save.boat-1)*.08+(luckyBoost?.9:0);
 const rare=['Hiếm','Cực hiếm','Huyền thoại'];
 const weighted=list.map(o=>({f:o.f,w:o.w*(rare.includes(o.f.rarity)?1+boost:1)}));
 let n=Math.random()*weighted.reduce((sum,o)=>sum+o.w,0);for(const o of weighted){n-=o.w;if(n<=0)return o.f;}return weighted[0]?.f||species[0];
}
