function applyPerformance(){const world=$('world');if(!world)return;world.classList.remove('quality-smooth','quality-balanced','quality-beautiful');world.classList.add('quality-'+(save.quality||'balanced'));}

function tone(freq,duration){if(!save.sound)return;try{audio=audio||new(window.AudioContext||window.webkitAudioContext)();const o=audio.createOscillator(),g=audio.createGain();o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(.035,audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+duration);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+duration);}catch(e){}}
function spawnFish(){const host=document.getElementById('fishSwarm');if(!host)return;host.innerHTML='';const n={smooth:16,balanced:28,beautiful:44}[save.quality]||22;const NS='http://www.w3.org/2000/svg';const frag=document.createDocumentFragment();for(let i=0;i<n;i++){const d=Math.random(),far=d<.36,near=d>.8,y=355+Math.random()*248,s=far?.26+Math.random()*.16:near?.62+Math.random()*.42:.36+Math.random()*.22,rev=Math.random()<.5,dur=(far?23:near?10:15)+Math.random()*9,delay=-Math.random()*dur,hue=Math.round(Math.random()*300-40);const g=document.createElementNS(NS,'g');g.setAttribute('class','fish-proc '+(far?'far':near?'near':'mid')+(rev?' rev':''));g.setAttribute('style',`--y:${y.toFixed(0)}px;--hue:${hue}deg;animation-duration:${dur.toFixed(2)}s;animation-delay:${delay.toFixed(2)}s;transform:scale(${(rev?-s:s).toFixed(2)},${s.toFixed(2)})`);g.innerHTML='<use href="#fishTpl"/>';frag.appendChild(g);}host.appendChild(frag);}
function spawnBubbles(){const host=document.getElementById('bubbleField');if(!host)return;const extra={smooth:6,balanced:14,beautiful:24}[save.quality]||14;const NS='http://www.w3.org/2000/svg';for(let i=0;i<extra;i++){const c=document.createElementNS(NS,'circle'),dur=3.4+Math.random()*4.6,delay=-Math.random()*dur;c.setAttribute('class','bubble b'+(1+i%4));c.setAttribute('cx',(130+Math.random()*900).toFixed(0));c.setAttribute('cy',(555+Math.random()*55).toFixed(0));c.setAttribute('r',(1.5+Math.random()*4.3).toFixed(1));c.setAttribute('style',`animation-duration:${dur.toFixed(2)}s;animation-delay:${delay.toFixed(2)}s`);host.appendChild(c);}}
function spawnCaustics(){const host=document.getElementById('caustics');if(!host)return;const NS='http://www.w3.org/2000/svg';for(let i=0;i<6;i++){const p=document.createElementNS(NS,'ellipse');p.setAttribute('cx',(110+Math.random()*890).toFixed(0));p.setAttribute('cy',(398+Math.random()*195).toFixed(0));p.setAttribute('rx',(24+Math.random()*42).toFixed(0));p.setAttribute('ry',(6+Math.random()*5).toFixed(0));p.setAttribute('class','caustic');p.setAttribute('style','animation-delay:'+(-Math.random()*7).toFixed(2)+'s');host.appendChild(p);}}
function spawnSparkles(tier){const host=document.getElementById('sparkleBurst');if(!host)return;host.innerHTML='';const NS='http://www.w3.org/2000/svg';const n=tier==='legend'?22:14;const color=tier==='legend'?'#ffe9a8':'#e9c8ff';for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,d=28+Math.random()*68;const p=document.createElementNS(NS,'path');p.setAttribute('d','M0 -5l1.6 3.4 3.4 1.6-3.4 1.6L0 10l-1.6-3.4L-5 5l3.4-1.6Z');p.setAttribute('fill',color);const x=(760+Math.cos(a)*d).toFixed(0),y=(394+Math.sin(a)*d).toFixed(0),dur=(.7+Math.random()*.4).toFixed(2);p.setAttribute('style',`transform-box:fill-box;transform-origin:center;transform:translate(${x}px,${y}px);animation:sparkleFly ${dur}s ease-out forwards`);host.appendChild(p);}setTimeout(()=>{host.innerHTML='';},1300);}
function breachFish(){const host=document.getElementById('breachLayer');if(!host)return;const x=140+Math.random()*820,hue=Math.round(Math.random()*300-40);const g=document.createElementNS('http://www.w3.org/2000/svg','g');g.setAttribute('class','breach-fish');g.setAttribute('style',`--bx:${x.toFixed(0)}px;--hue:${hue}deg`);g.innerHTML='<use href="#fishTpl" transform="scale(1.15)"/>';host.appendChild(g);const ring=document.createElementNS('http://www.w3.org/2000/svg','ellipse');ring.setAttribute('class','ripple');ring.setAttribute('cx',x.toFixed(0));ring.setAttribute('cy',392);ring.setAttribute('rx',18);ring.setAttribute('ry',6);host.appendChild(ring);setTimeout(()=>{g.remove();ring.remove();},1300);}
function scheduleBreach(){const gap=(save.quality==='smooth'?15:8)+Math.random()*9;setTimeout(()=>{breachFish();scheduleBreach();},gap*1000);}
function spawnRainRipple(){const host=document.getElementById('rainRipples');if(!host||!$('world').classList.contains('rain'))return;const e=document.createElementNS('http://www.w3.org/2000/svg','ellipse'),x=100+Math.random()*900;e.setAttribute('class','ripple');e.setAttribute('cx',x.toFixed(0));e.setAttribute('cy',(356+Math.random()*10).toFixed(0));e.setAttribute('rx',6);e.setAttribute('ry',2.4);host.appendChild(e);setTimeout(()=>e.remove(),2500);}
function scheduleRain(){spawnRainRipple();setTimeout(scheduleRain,350+Math.random()*450);}
function spawnMotes(){const host=document.getElementById('bubbleField');if(!host)return;const rayZones=[[20,195],[345,535],[785,995]];const NS='http://www.w3.org/2000/svg';const n={smooth:4,balanced:8,beautiful:14}[save.quality]||8;for(let i=0;i<n;i++){const z=rayZones[i%3],x=z[0]+Math.random()*(z[1]-z[0]);const c=document.createElementNS(NS,'circle'),dur=5+Math.random()*5,delay=-Math.random()*dur;c.setAttribute('class','bubble b'+(1+i%4));c.setAttribute('cx',x.toFixed(0));c.setAttribute('cy',(430+Math.random()*150).toFixed(0));c.setAttribute('r',(1+Math.random()*1.6).toFixed(1));c.setAttribute('style',`fill:#fff6d8;stroke:none;animation-duration:${dur.toFixed(2)}s;animation-delay:${delay.toFixed(2)}s`);host.appendChild(c);}}
function spawnShootingStar(){const host=document.getElementById('shootingStar');if(!host||!$('world').classList.contains('night'))return;const y0=60+Math.random()*120,x0=550+Math.random()*450;const l=document.createElementNS('http://www.w3.org/2000/svg','line');l.setAttribute('x1',x0);l.setAttribute('y1',y0);l.setAttribute('x2',x0-46);l.setAttribute('y2',y0-22);l.setAttribute('stroke','#fff');l.setAttribute('stroke-width','2');l.setAttribute('stroke-linecap','round');l.setAttribute('class','shoot-trail');host.appendChild(l);setTimeout(()=>l.remove(),900);}
function scheduleShootingStar(){spawnShootingStar();setTimeout(scheduleShootingStar,9000+Math.random()*11000);}
ensureDaily();updateScene();$('world').classList.add(save.zone);applyPerformance();updateStatus();render();startLoop();spawnFish();spawnBubbles();spawnCaustics();scheduleBreach();scheduleRain();spawnMotes();scheduleShootingStar();
})();
</script>
</body>
