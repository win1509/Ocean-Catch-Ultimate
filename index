function catchFish(){mode='result';reeling=false;fishWeight=+(fish.min+Math.random()*(fish.max-fish.min)).toFixed(2);fishWeight=+(fishWeight*(1+(save.rod-1)*.025)).toFixed(2);reward=Math.max(1,Math.round(fishWeight*fish.price*(1+(save.boat-1)*.09)));streak++;const streakBonus=Math.min(.5,(streak-1)*.05);if(streakBonus>0)reward=Math.round(reward*(1+streakBonus));save.coins+=reward;save.caught++;ensureDaily();save.daily.caught++;save.best=Math.max(save.best,fishWeight);if(!save.discovered.includes(fish.id))save.discovered.push(fish.id);persist();say(`${fish.emoji} ${fish.name}!`,`Bạn câu được ${fishWeight.toFixed(2)} kg · +${reward} vàng`);updateStatus();render();showCatchBanner();tone(820,.1);setTimeout(()=>tone(1040,.12),120);toast(`Tuyệt vời! +${reward} vàng`);}
function lineBreak(){mode='idle';reeling=false;progress=0;lineHealth=1;streak=0;say('Cá đã thoát mất rồi!','Thử lại nhé — lần tới bạn sẽ bắt được nó.');updateStatus();render();toast('Dây câu bị căng quá! Cá đã thoát.');tone(160,.16);}
function tick(dt){if(mode==='casting'){phase+=dt;if(phase>.8){mode='waiting';waitLeft=Math.max(.85,2.9+Math.random()*2.15-(save.bait-1)*.22-(save.sonar-1)*.16-(save.boat-1)*.05);say('Mồi câu đã chạm nước!','Mặt nước gợn nhẹ... có cá đang đến.');updateStatus();render();}}else if(mode==='waiting'){waitLeft-=dt;if(waitLeft<=0)beginFight();}else if(mode==='fight'){phase+=dt;tension=.5+.37*Math.sin(phase*2.5)+.1*Math.sin(phase*5.3);tension=Math.max(.04,Math.min(.96,tension));if(reeling){if(tension>.86){lineHealth-=dt*Math.max(.075,.20-(save.rod-1)*.014);progress=Math.max(0,progress-dt*.045);}else if(tension<.14){progress+=dt*.07;}else{progress+=dt*(.205+(save.reel-1)*.038+(save.rod-1)*.012+(save.bait-1)*.009);}}else{lineHealth=Math.min(1,lineHealth+dt*(.045+(save.rod-1)*.006));}if(lineHealth<=0){lineBreak();return;}if(progress>=1){catchFish();return;}}sceneTimer+=dt;if(sceneTimer-weatherTimer>42){weatherTimer=sceneTimer;weatherIndex=(weatherIndex+1+Math.floor(Math.random()*2))%weatherTypes.length;updateScene();}if(['casting','waiting','fight'].includes(mode)){if(clock+dt>.12){clock=0;render();}else{clock+=dt;}}}
let last=performance.now(),loopTimer=null;
function loop(){
 const now=performance.now(),dt=Math.min(.16,(now-last)/1000||0);last=now;
