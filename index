/* OCEAN CATCH — visible motion layer. Kept active so the world still animates on systems
   that report reduced-motion; movement is gentle and does not affect game performance. */
.world .cloud{animation:cloudDriftOne 25s ease-in-out infinite alternate!important;will-change:transform}
.world .cloud.c2{animation:cloudDriftTwo 34s ease-in-out infinite alternate-reverse!important}
.world .wave-a{animation:waveSurgeOne 4.8s ease-in-out infinite alternate!important;transform-box:fill-box;will-change:transform}
.world .wave-b{animation:waveSurgeTwo 6.2s ease-in-out infinite alternate-reverse!important;transform-box:fill-box;will-change:transform}
.world .water-shimmer{animation:waterGlitter 2.8s ease-in-out infinite alternate!important}
.world .fish-swim{animation:fishCross 12s linear infinite!important;will-change:transform}
.world .fish-swim.s2{animation:fishCrossTwo 15s linear -7s infinite!important}
.world .fish-tail{transform-box:fill-box;transform-origin:100% 50%;animation:tailKick .28s ease-in-out infinite alternate!important}
.world .small-fish{animation:reefFishBob 1.15s ease-in-out infinite alternate!important}
